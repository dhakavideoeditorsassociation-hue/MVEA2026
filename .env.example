# ---------------------------------------------------------------------------
# Gonomadhyam Video Editor Association — environment variables
#
# Every variable is optional. With none of them set the app runs in demo mode:
# seed content, browser-local auth, browser-local admin changes.
# Copy this file to `.env.local` and fill in what you have.
# ---------------------------------------------------------------------------

# Firebase web app config (Project settings → General → Your apps → SDK setup)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Cloudinary unsigned upload preset (Settings → Upload → Add upload preset,
# set "Signing mode" to Unsigned). Used for avatars, CV PDFs and banners.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Optional: only used if you later add an email provider for recruiter
# inquiries and membership decisions (e.g. Resend / SendGrid).
# RESEND_API_KEY=
# EMAIL_FROM="GVEA <hello@gvea.org>"
